# 서버의 deploy/.env 견본. compose가 읽는 값이고 비밀값이 아니다. 비밀은 env/*.env에 둔다.
# 이미지 저장소(팀 AWS 계정의 ECR). 서버는 ecr-login 도우미로 자기 역할을 써서 받는다(bootstrap.sh)
REGISTRY=<계정ID>.dkr.ecr.ap-northeast-2.amazonaws.com
# 운영 주소. 스테이징은 staging.<이 주소>다
SITE_DOMAIN=pingopingo.duckdns.org
# 지금 올라가 있는 이미지 태그. deploy.sh가 고친다(손으로 고치지 않는다)
PROD_TAG=v0.1.0
STAGING_TAG=sha-0000000
# 서버 안 DB를 쓰는 동안은 두 파일을 함께 쓴다. RDS로 옮기면 compose.yml만 남긴다
COMPOSE_FILE=compose.yml:compose.db.yml
