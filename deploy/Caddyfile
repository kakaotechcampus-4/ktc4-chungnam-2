# 앞단 프록시(#168). 환경마다 한 주소에서 화면과 API를 함께 낸다 — 세션 쿠키가 SameSite=lax라 화면과 API가 같은 사이트여야
# 로그인이 된다. /api/*는 앞의 /api를 떼고 API로, 나머지는 화면으로 보낸다(백엔드 경로는 그대로).
# 접근 로그는 켜지 않는다 — /places/nearest의 쿼리스트링(누른 좌표)이 남는다(#473).

(app) {
	encode zstd gzip
	handle_path /api/* {
		reverse_proxy {args[0]}:8000 {
			# SSE(/maps/{id}/events)를 모아 두지 않고 바로 흘려보낸다
			flush_interval -1
			# 배포로 API 컨테이너가 다시 뜨는 동안(약 10~30초) 502를 바로 돌려주지 않고 이 시간까지 연결을 다시 시도한다 — 그동안 요청은 느려질 뿐 실패하지 않는다(#1403)
			lb_try_duration 30s
			lb_try_interval 500ms
		}
	}
	# 초대 링크 미리보기(#1625). 메신저 미리보기 봇은 스크립트를 실행하지 않아 화면(index.html)의 고정 og 태그만 읽는다.
	# 봇이 여는 /invites/{token}만 API의 미리보기 문서로 보낸다. 사람(카톡 안 브라우저 포함)은 아래 화면으로 간다.
	# 카톡 봇은 kakaotalk-scrap, 카톡 안 브라우저는 KAKAOTALK이라 겹치지 않는다.
	@invite_preview {
		path_regexp invite ^/invites/([^/]+)/?$
		header_regexp bot User-Agent (?i)(kakaotalk-scrap|facebookexternalhit|twitterbot|slackbot|discordbot|telegrambot)
	}
	handle @invite_preview {
		rewrite * /invites/{re.invite.1}/preview
		reverse_proxy {args[0]}:8000
	}
	handle {
		reverse_proxy {args[1]}:80 {
			# 화면 컨테이너가 다시 뜨는 동안도 같다
			lb_try_duration 30s
			lb_try_interval 500ms
		}
	}
}

{$SITE_DOMAIN} {
	import app api-prod web-prod
}

staging.{$SITE_DOMAIN} {
	header X-Robots-Tag "noindex, nofollow"
	import app api-staging web-staging
}
