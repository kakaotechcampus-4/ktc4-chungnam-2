# 서버의 deploy/env/prod.env 견본 — 값은 서버에서만 채운다(권한 600). 저장소, 이미지, 채팅에 남기지 않는다.
# 키의 뜻은 backend/.env.example, 규칙은 deploy_rules.md 「배포할 때마다」.
PINGO_ENV=prod
# 서버 안 DB(compose.db.yml). RDS로 옮기면 move-to-rds.sh가 아래 RDS_DATABASE_URL 값으로 바꾼다(#873)
DATABASE_URL=postgresql://pingo:<비밀번호>@db:5432/pingo_prod
# rds-setup.sh가 적는다 — 이 환경 전용 앱 계정(pingo_prod_app), SSL 필수
# RDS_DATABASE_URL=postgresql://pingo_prod_app:<비밀번호>@<RDS_HOST>:5432/pingo_prod?sslmode=require
SESSION_SECRET=<운영 전용, 스테이징과 다른 값>
FRONTEND_BASE_URL=https://ktc-pingopingo.duckdns.org
CORS_ALLOW_ORIGINS=https://ktc-pingopingo.duckdns.org
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=https://ktc-pingopingo.duckdns.org/api/auth/kakao/callback
KAKAO_REST_API_KEY=
PLACES_MODE=real
LLM_MODE=real
# 모델 제공자: 2026-11-02부터 OpenAI API 직접 호출(#1120). 환경마다 OpenAI 프로젝트의 키를 따로 쓴다. 변수 이름만 ELICE로 남았다
ELICE_ML_API_BASE_URL=https://api.openai.com/v1
ELICE_ML_API_KEY=
LOG_LEVEL=INFO
# 위 KAKAO_*와 ELICE_*가 비면 서버가 뜨지 않는다(#810). 아래는 적지 않으면 기본값이다(deploy_rules.md「DB 연결 수」)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# QA_LOGIN_SECRET은 운영에 넣지 않는다 — 넣으면 서버가 뜨지 않는다(#789)
# 광고 보고 크레딧 충전(docs/credits-reviews.md 3.7)은 운영에서 꺼 둔다(비움). fake를 넣으면 서버가 뜨지 않는다(#1038).
# adsense, gpt는 화면에 그 광고 제공자가 생긴 뒤 단위 id(CREDIT_AD_UNIT_ID)와 함께 넣는다 — 아직 없다
# CREDIT_AD_PROVIDER=
# CREDIT_AD_UNIT_ID=
