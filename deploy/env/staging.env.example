# 서버의 deploy/env/staging.env 견본 — 값은 서버에서만 채운다(권한 600).
PINGO_ENV=staging
DATABASE_URL=postgresql://pingo:<비밀번호>@db:5432/pingo_staging
SESSION_SECRET=<스테이징 전용, 운영과 다른 값 — 스테이징 쿠키가 운영에서 통하지 않게>
FRONTEND_BASE_URL=https://staging.pingopingo.duckdns.org
CORS_ALLOW_ORIGINS=https://staging.pingopingo.duckdns.org
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=https://staging.pingopingo.duckdns.org/api/auth/kakao/callback
KAKAO_REST_API_KEY=
PLACES_MODE=real
LLM_MODE=real
ELICE_ML_API_BASE_URL=
ELICE_ML_API_KEY=
LOG_LEVEL=INFO
AGENT_LOOP_IN_PROCESS=1
# QA 하네스(qa/harness/run_api_cases.py --base-url)가 쓰는 스테이징 전용 로그인(#789)
QA_LOGIN_SECRET=<스테이징 전용 값>
