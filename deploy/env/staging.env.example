# 서버의 deploy/env/staging.env 견본 — 값은 서버에서만 채운다(권한 600).
PINGO_ENV=staging
# 서버 안 DB(compose.db.yml). RDS로 옮기면 move-to-rds.sh가 아래 RDS_DATABASE_URL 값으로 바꾼다(#873)
DATABASE_URL=postgresql://pingo:<비밀번호>@db:5432/pingo_staging
# rds-setup.sh가 적는다 — 이 환경 전용 앱 계정(pingo_staging_app), SSL 필수
# RDS_DATABASE_URL=postgresql://pingo_staging_app:<비밀번호>@<RDS_HOST>:5432/pingo_staging?sslmode=require
SESSION_SECRET=<스테이징 전용, 운영과 다른 값 — 스테이징 쿠키가 운영에서 통하지 않게>
FRONTEND_BASE_URL=https://staging.ktc-pingopingo.duckdns.org
CORS_ALLOW_ORIGINS=https://staging.ktc-pingopingo.duckdns.org
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=https://staging.ktc-pingopingo.duckdns.org/api/auth/kakao/callback
KAKAO_REST_API_KEY=
PLACES_MODE=real
LLM_MODE=real
# 모델 제공자: 2026-11-02부터 OpenAI API 직접 호출(#1120). 환경마다 OpenAI 프로젝트의 키를 따로 쓴다. 변수 이름만 ELICE로 남았다
ELICE_ML_API_BASE_URL=https://api.openai.com/v1
ELICE_ML_API_KEY=
LOG_LEVEL=INFO
# 위 KAKAO_*와 ELICE_*가 비면 서버가 뜨지 않는다(#810). 아래는 적지 않으면 기본값이다(deploy_rules.md「DB 연결 수」)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# COOKIE_SECURE는 적지 않으면 1이다. 로컬 http로 띄워 하네스를 돌릴 때만 0
# QA 하네스(qa/harness/run_api_cases.py --base-url)가 쓰는 스테이징 전용 로그인(#789)
QA_LOGIN_SECRET=<스테이징 전용 값>
# 광고 보고 크레딧 충전(docs/credits-reviews.md 3.7, #1037). fake는 잔액 부족 안내의 테스트 광고 창이다. 비우면 꺼진다
CREDIT_AD_PROVIDER=fake
