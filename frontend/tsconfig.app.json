{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* contracts(../contracts) 는 빌드 산출물이 없는 소스 전용 패키지다.
       file: 의존성으로 붙이면 Vite 가 node_modules 안의 .ts 를 변환하지 않아 깨진다.
       그래서 alias 로 소스를 직접 가리킨다 — 런타임 해석은 vite.config.ts 의 resolve.alias,
       타입 해석은 아래 paths 가 담당한다. 둘 중 하나만 있으면 한쪽만 깨진다. */
    /* baseUrl 없이 paths 만 쓴다 — TS 6 에서 baseUrl 은 deprecated 고,
       paths 는 이 tsconfig 파일 위치 기준으로 해석되므로 결과가 같다. */
    "paths": {
      "@/*": ["./src/*"],
      "@pingo/contracts/*": ["../contracts/*"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
