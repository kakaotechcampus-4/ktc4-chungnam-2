# 화면 정적 파일 서버(이미지 안). HTTPS와 /api 나누기는 앞단 Caddy(deploy/Caddyfile)가 한다.
#
# 캐시 규칙(멘토 리뷰): 빌드 파일(/assets/*)은 이름에 해시가 붙어 있어 오래 캐시하고, 화면(index.html)은 매번 새로 받는다.
# - index.html은 /와 /index.html뿐 아니라 화면 주소(/maps/... 등)로 받을 때도 no-cache다. 화면 주소에 캐시 헤더가 없으면
#   브라우저가 옛 index.html을 다시 쓰고, 그 안의 옛 빌드 파일 이름이 새 이미지에 없어 배포 직후 깊은 주소에서 빈 화면이 된다.
# - /assets 안에 없는 파일은 404다. index.html로 대신 주면 HTML이 JS 자리로 가서 빈 화면이 되고, 그 응답이 1년 캐시까지 됐다.
:80 {
	root * /srv
	encode zstd gzip

	handle /assets/* {
		@exists file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# 그 밖의 주소는 화면이다 — 있는 파일(favicon 등)은 그대로, 화면 주소는 index.html로 주고 화면 라우터가 처리한다
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
