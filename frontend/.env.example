# 카카오맵 JS SDK 앱키 (JavaScript 키).
# https://developers.kakao.com → 내 애플리케이션 → 앱 키 → JavaScript 키
# 플랫폼 > Web 에 http://localhost:5173 을 등록해야 SDK 가 뜬다 (미등록이면 onerror).
# 값은 .env.local 에 넣는다 — 이 파일은 예시라 커밋되고, .env.local 은 커밋되지 않는다.
VITE_KAKAO_MAP_KEY=

# 실제 백엔드 주소. 채우면 목 서버가 꺼지고 이 주소로 요청한다 (예: http://localhost:8000).
# 비워두면 목 서버(msw)로 돈다 — BE 없이 화면 개발할 때.
VITE_API_BASE_URL=

