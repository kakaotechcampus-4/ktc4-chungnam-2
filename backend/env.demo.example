# ─────────────────────────────────────────────────────────────────────────────
# 팀원용 시연 설정 예시. docs/team-setup-guide.md 3절을 따라 이 파일을 복사해서 `backend/.env` 로 만든다.
#   PowerShell:  Copy-Item env.demo.example .env
# `.env` 는 깃이 자동으로 무시하니 키를 넣어도 올라가지 않는다. 이 예시 파일에는 키를 절대 적지 않는다.
#
# 아래 ★ 표시 4곳(KAKAO 2개, ELICE 2개)은 팀 리드에게 개인 메시지로 받아서 `=` 바로 뒤에 붙여 넣는다.
# 규칙: `=` 앞뒤에 공백·따옴표를 넣지 않는다. 값 뒤에 # 주석을 붙이지 않는다(주석은 항상 별도 줄에).
# ─────────────────────────────────────────────────────────────────────────────

# 내 컴퓨터의 데이터베이스(docker compose 가 만들어 준다). 그대로 둔다.
DATABASE_URL=postgresql://pingo:pingo@localhost:5432/pingo
REDIS_URL=redis://localhost:6379/0

# 개발 모드. 꼭 적어야 한다(안 적으면 서버가 안 켜진다).
PINGO_ENV=dev

# 진짜 장소 검색(카카오)과 진짜 AI(엘리스)를 쓴다.
PLACES_MODE=real
LLM_MODE=real
LLM_MODEL=gpt-5.6-luna

# 로그인 쿠키 서명용 임의의 문자열. 아무 긴 글자로 바꿔도 된다.
SESSION_SECRET=team-demo-session-secret-change-me-0123456789

# 화면 주소(프론트). 그대로 둔다.
FRONTEND_BASE_URL=http://localhost:5173

# 카카오 로그인이 끝나고 돌아오는 주소. 카카오 개발자 콘솔에 같은 값이 등록돼 있어야 한다. 그대로 둔다.
KAKAO_REDIRECT_URI=http://localhost:8000/auth/kakao/callback

# ★ 카카오 REST API 키
KAKAO_CLIENT_ID=
# ★ 카카오 Client Secret
KAKAO_CLIENT_SECRET=

# ★ 엘리스 ML API 주소와 키(AI가 사람 말을 조건으로 정리할 때 쓴다)
ELICE_ML_API_BASE_URL=
ELICE_ML_API_KEY=
