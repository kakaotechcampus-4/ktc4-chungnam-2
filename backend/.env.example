# 복사해서 .env로 쓴다. 실제 값은 커밋하지 않는다(.gitignore가 이미 막고 있음).

DATABASE_URL=postgresql://pingo:pingo@localhost:5432/pingo
REDIS_URL=redis://localhost:6379/0

KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8000/auth/kakao/callback

# 카카오 로그인 성공 후 리다이렉트할 FE 진입점. FE 배포 도메인이 정해지면 절대 URL로 채운다.
FRONTEND_LOGIN_REDIRECT_URL=/

SESSION_SECRET=change-me-before-deploy

# dev|test|prod. prod면 아래 PLACES_MODE/AUTH_MODE가 하나라도 dev면
# 서버가 뜨지 않는다(common/settings.py ConfigError).
PINGO_ENV=dev

# 콤마로 구분한 FE 오리진 목록. prod에서는 "*"를 쓸 수 없다(쿠키 인증 + 와일드카드는
# 브라우저가 거부한다) — 실제 FE 도메인을 명시한다.
CORS_ALLOW_ORIGINS=

# 값을 비워두지 말고 아예 지워라 — KEY=처럼 빈 값으로 남겨두면 "설정 안 됨"이 아니라
# "빈 문자열로 설정됨"으로 읽혀서, dev 환경의 localhost 정규식 기본값이 무력화되고
# 그 자리엔 아무 오리진도 못 붙는다. 쓸 값이 없으면 이 줄 자체를 지운다.
# CORS_ALLOW_ORIGIN_REGEX=

# dev|real. places(#34)/auth(#4) 각 포트의 어댑터 모드 — 실구현이 준비되기 전까지는
# dev(개발용 스텁)를 쓴다. prod에서는 지정을 안 하면 자동으로 real이 기본값이 된다
# (스텁이 조용히 올라가는 걸 막기 위함) — 안 정하면 real을 요구하다가 실구현이 없어서
# ConfigError로 죽는다. membership은 여기 없다(issue #89) — maps.api.DbMembershipGateway가
# 유일한 구현이라 더 이상 모드를 고를 필요가 없다(authz/deps.py가 직접 그 클래스를 쓴다).
PLACES_MODE=dev
AUTH_MODE=dev
