# 복사해서 .env로 쓴다. 실제 값은 커밋하지 않는다(.gitignore가 이미 막고 있음).

DATABASE_URL=postgresql://pingo:pingo@localhost:5432/pingo
REDIS_URL=redis://localhost:6379/0

KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8000/auth/kakao/callback

# FE 오리진 정본(루트 확정, 2026-09-23) — 초대 링크(maps)와 로그인 리다이렉트(auth) 둘 다
# 이 값을 쓴다. 비우면 dev 기본값(Vite 개발 서버)이 들어간다.
FRONTEND_BASE_URL=http://localhost:5173

# 로그인 성공 후 리다이렉트할 FE 진입점. 비워두면 FRONTEND_BASE_URL + "/"로 자동 채워진다 —
# 특정 경로(예: 로그인 직후 진입점 화면)로 보내고 싶을 때만 절대 URL로 직접 채운다.
FRONTEND_LOGIN_REDIRECT_URL=

SESSION_SECRET=change-me-before-deploy

# dev|test|prod. **안 적으면 prod다**(#126) — 배포에서 빠뜨려도 가장 엄격한 검사가 돌게 하려는 것이다.
# 로컬 개발은 .env에 PINGO_ENV=dev를 꼭 적는다. prod면 아래 PLACES_MODE/LLM_MODE가 하나라도 dev거나
# SESSION_SECRET 등이 기본값이면 서버가 뜨지 않는다(common/settings.py ConfigError).
PINGO_ENV=dev

# 콤마로 구분한 FE 오리진 목록. prod에서는 "*"를 쓸 수 없다(쿠키 인증 + 와일드카드는
# 브라우저가 거부한다) — 실제 FE 도메인을 명시한다.
CORS_ALLOW_ORIGINS=

# 값을 비워두지 말고 아예 지워라 — KEY=처럼 빈 값으로 남겨두면 "설정 안 됨"이 아니라
# "빈 문자열로 설정됨"으로 읽혀서, dev 환경의 localhost 정규식 기본값이 무력화되고
# 그 자리엔 아무 오리진도 못 붙는다. 쓸 값이 없으면 이 줄 자체를 지운다.
# CORS_ALLOW_ORIGIN_REGEX=

# dev|real. places(#34)/llm 각 포트의 어댑터 모드 — 실구현이 준비되기 전까지는
# dev(개발용 스텁)를 쓴다. prod에서는 지정을 안 하면 자동으로 real이 기본값이 된다(스텁이
# 조용히 올라가는 걸 막기 위함) — 안 정하면 real을 요구하다가 실구현이 없어서 ConfigError로
# 죽는다. membership은 여기 없다(issue #89) — maps.api.DbMembershipGateway가 유일한 구현이라
# 더 이상 모드를 고를 필요가 없다(authz/deps.py가 직접 그 클래스를 쓴다).
PLACES_MODE=dev
# 인증은 모드가 없다(#126) — 개발용 스텁과 AUTH_MODE를 없앴다. 로컬에 남은 AUTH_MODE 줄은 지워도 된다.

# places 실시간 연결(#34a) — 지도 API 키. 실제 값은 .env에만, 커밋 금지. 키가 없는 소스는 건너뛴다.
# 값이 없으면 줄을 비우지 말고 지운다(빈 문자열로 설정됨과 설정 안 됨은 다르다 — 위 주의와 같다).
# 카카오: REST API 키. 없으면 KAKAO_CLIENT_ID로 폴백한다.
# KAKAO_REST_API_KEY=
# 네이버 검색 API(지역 검색) — 유료 지도 SDK 키와 다른 상품이다.
# NAVER_SEARCH_CLIENT_ID=
# NAVER_SEARCH_CLIENT_SECRET=
# 구글 Places API(New) — 과금 있음.
# GOOGLE_PLACES_API_KEY=
# 소스 순서 = 폴백 순서. v1 기본은 kakao 하나(#53, #188). 네이버·구글은 켤 때만(예: kakao,naver,google).
# PLACES_SOURCES=kakao
# 지도 API 응답은 캐시하지 않는다(#188) — 캐시 설정 없음.
# PLACES_HTTP_TIMEOUT_S=3
# PLACES_HTTP_RETRIES=1
# 구글 호출 상한(프로세스 수명 동안, 과금 안전장치). 0이면 무제한.
# PLACES_GOOGLE_MAX_CALLS=100
# GET /places/search 사용자당 분당 호출 상한(인메모리 — 프로세스 재시작·인스턴스 여러 개면 따로 센다). 초과 시 429.
# PLACES_SEARCH_PER_MIN=30

# LLM(엘리스 ML API, #12 확정 / real 구현은 #116). 실제 키는 여기 적지 않는다 — .env에만.
# 주의: KEY=처럼 빈 값은 "설정 안 됨"이 아니라 "빈 문자열로 설정됨"이다(위 CORS_ALLOW_ORIGIN_REGEX와
# 같은 사례). 키가 없으면 줄을 비우지 말고 지운다. LLM_MODEL을 비워 두면 기본값 gpt-5.6-luna가
# 아니라 빈 모델명이 들어간다 — 기본값을 쓰려면 줄 자체를 지운다.
# LLM_MODE: dev|real. prod에서 dev면 서버가 뜨지 않는다(미지정 시 prod 기본값은 real).
ELICE_ML_API_BASE_URL=
ELICE_ML_API_KEY=
# LLM_MODEL=gpt-5.6-luna
LLM_MODE=dev
